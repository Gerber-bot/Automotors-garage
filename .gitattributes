# ------------------------------------------------------------------------------
# Automotors Garage - Git Attributes & Line Ending Policy
# ------------------------------------------------------------------------------
# Default: auto-detect text files and normalize line endings to LF in the object store
* text=auto

# CRITICAL WINDOWS COMPATIBILITY:
# Windows cmd.exe fails to parse .bat files that use Unix LF line endings,
# resulting in syntax errors (e.g. 'erminar', 'CRIPT_DIR' unrecognized commands).
# Setting -text ensures Git treats batch scripts as binary/verbatim, preventing
# Git from converting CRLF to LF in the repository object database.
# This guarantees that GitHub 'Download ZIP' and git clones always contain CRLF.
*.bat -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.cmd -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# PowerShell scripts (Windows CRLF by default)
*.ps1 text eol=crlf
