{
  "name": "automotors-garage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "dependencies": {
    "@automotors/database": "file:./packages/database",
    "@automotors/obd-core": "file:./packages/obd-core",
    "@automotors/security-foundation": "file:./packages/security-foundation"
  },
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/powershell/start-dev.ps1",
    "dev:demo": "powershell -ExecutionPolicy Bypass -File scripts/powershell/start-demo.ps1",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/powershell/stop-dev.ps1",
    "dev:check": "powershell -ExecutionPolicy Bypass -File scripts/utilities/check-env.ps1",
    "dev:health": "powershell -ExecutionPolicy Bypass -File scripts/utilities/check-health.ps1",
    "dev:mobile": "powershell -ExecutionPolicy Bypass -File scripts/powershell/start-mobile.ps1",
    "dev:stack": "powershell -ExecutionPolicy Bypass -File scripts/powershell/start-stack.ps1",
    "dev:stack:stop": "powershell -ExecutionPolicy Bypass -File scripts/powershell/stop-stack.ps1",
    "start:api": "node --experimental-strip-types apps/backend/src/main.ts",
    "seed:demo": "node --experimental-strip-types scripts/database/seed-demo.ts",
    "build": "npm --prefix apps/frontend run build",
    "dev:frontend": "powershell -ExecutionPolicy Bypass -File scripts/powershell/start-frontend.ps1",
    "test": "node --experimental-strip-types --test packages/security-foundation/src/tests/security-foundation.spec.ts packages/obd-core/test/obd-core.spec.ts apps/backend/test/vehicle-history-engine.spec.ts apps/backend/test/maintenance-intelligence.spec.ts apps/frontend/test/frontend-components.spec.ts apps/frontend/test/design-system-components.spec.ts packages/database/test/database.spec.ts tests/integration/persistence-foundation.spec.ts tests/integration/milestone-08-e2e.spec.ts tests/integration/milestone-10-3-e2e.spec.ts tests/integration/milestone-11-obd.spec.ts tests/integration/milestone-12-mi-automotors.spec.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --project packages/security-foundation/tsconfig.json --noEmit && tsc --project packages/database/tsconfig.json --noEmit && tsc --project packages/obd-core/tsconfig.json --noEmit && tsc --project apps/backend/tsconfig.json --noEmit && tsc --project apps/frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.38.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "pg": "^8.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "zod": "^4.6.7"
  }
}
