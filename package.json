{
  "name": "automotors-garage",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "node --experimental-strip-types --test packages/security-foundation/src/tests/security-foundation.spec.ts apps/backend/test/vehicle-history-engine.spec.ts apps/backend/test/maintenance-intelligence.spec.ts apps/frontend/test/frontend-components.spec.ts",
    "lint": "pnpm -r run lint",
    "typecheck": "tsc --project packages/security-foundation/tsconfig.json --noEmit && tsc --project apps/backend/tsconfig.json --noEmit && tsc --project apps/frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "zod": "^4.6.7"
  }
}
