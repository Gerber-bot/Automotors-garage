# ==============================================================================
# AUTOMOTORS GARAGE - Environment Variables Template
# ==============================================================================
# Security Notice: Do NOT store sensitive secrets in this template.
# Copy this file to .env and configure real credentials securely.

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_secure_password
DATABASE_NAME=automotors_garage
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}?schema=public
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# Authentication & Tokens (Argon2id & JWT)
# ------------------------------------------------------------------------------
# Secret must be at least 32 characters high-entropy random string
JWT_ACCESS_SECRET=replace_with_min_32_chars_random_secret_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_min_32_chars_random_secret_in_production
JWT_REFRESH_EXPIRATION=7d

# Argon2id Parameters (Memory: 65536 KiB, Iterations: 3, Parallelism: 4)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ------------------------------------------------------------------------------
# Multi-Tenancy & Tenant Context
# ------------------------------------------------------------------------------
TENANT_HEADER=x-tenant-id
ALLOW_CROSS_TENANT_SEARCH=false

# ------------------------------------------------------------------------------
# Storage / Evidence Vault (S3-compatible)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local # local | s3 | minio
STORAGE_BUCKET=automotors-garage-evidence
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ------------------------------------------------------------------------------
# AI & Transcription Service (Optional/Modular)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
AI_MODEL_WHISPER=whisper-1
AI_MODEL_COMPLETIONS=gpt-4o-mini

# ------------------------------------------------------------------------------
# Observability & Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=info # error | warn | info | debug
ENABLE_AUDIT_LOGGING=true
